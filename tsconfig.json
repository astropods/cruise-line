{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist"
  },
  "include": [
    "agent/**/*",
    "frontend/src/lib/scopePath.ts",
    "frontend/src/domain/**/*",
    "frontend/src/api/types.ts",
    "frontend/src/api/prs.ts",
    "frontend/src/api/client.ts",
    "frontend/src/lib/time.ts",
    "frontend/src/lib/time.test.ts",
    "frontend/src/features/inbox/inboxModel.ts",
    "frontend/src/features/inbox/inboxModel.test.ts",
    "frontend/src/features/architecture/mermaidSource.ts",
    "frontend/src/features/architecture/mermaidSource.test.ts",
    "frontend/src/features/chat/toolCallDetail.ts",
    "frontend/src/features/chat/toolCallDetail.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
