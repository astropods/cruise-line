{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist"
  },
  "include": [
    "agent/**/*",
    "frontend/src/lib/scopePath.ts",
    "frontend/src/domain/**/*",
    "frontend/src/api/types.ts",
    "frontend/src/api/prs.ts",
    "frontend/src/api/client.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
